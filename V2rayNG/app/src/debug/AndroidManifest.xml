<?xml version="1.0" encoding="utf-8"?>
<!--
  Stage 1 prototype launcher, DEBUG builds only.
  Merged into the main manifest by the Android manifest merger.
  The original v2rayNG launcher and all VPN components are unchanged.
  Remove this file when the redesign replaces MainActivity (Stage 3+).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".ui.ipgroups.IpGroupsPrototypeActivity"
            android:exported="true"
            android:label="IP Groups Prototype">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
